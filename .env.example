# ---------------------------------------------------------------------------
# 1. CAPABILITY BINDINGS — what backs each capability
#    (fill in whichever provider you're actually paying for; this is just an example)
# ---------------------------------------------------------------------------
AI_REASONING_PROVIDER=anthropic
AI_REASONING_MODEL=claude-sonnet-5

AI_FAST_PROVIDER=groq
AI_FAST_MODEL=llama-3.3-70b-versatile

AI_CHEAP_PROVIDER=openrouter
AI_CHEAP_MODEL=deepseek/deepseek-chat

AI_VISION_PROVIDER=google
AI_VISION_MODEL=gemini-2.5-flash

AI_SPEECH_PROVIDER=elevenlabs
AI_SPEECH_MODEL=eleven_turbo_v2

# ---------------------------------------------------------------------------
# 2. PROVIDER CREDENTIALS — how to reach each provider
#    KIND: anthropic | google | openai-compatible
#    BASE_URL required only for openai-compatible
# ---------------------------------------------------------------------------
AI_PROVIDER_ANTHROPIC_KIND=anthropic
AI_PROVIDER_ANTHROPIC_API_KEY=

AI_PROVIDER_GOOGLE_KIND=google
AI_PROVIDER_GOOGLE_API_KEY=

AI_PROVIDER_GROQ_KIND=openai-compatible
AI_PROVIDER_GROQ_API_KEY=
AI_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1

AI_PROVIDER_OPENROUTER_KIND=openai-compatible
AI_PROVIDER_OPENROUTER_API_KEY=
AI_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# 3. SPEECH PROVIDER CREDENTIALS
#    KIND: openai-compatible | elevenlabs
# ---------------------------------------------------------------------------
AI_SPEECH_PROVIDER_ELEVENLABS_KIND=elevenlabs
AI_SPEECH_PROVIDER_ELEVENLABS_API_KEY=
AI_SPEECH_PROVIDER_ELEVENLABS_DEFAULT_VOICE=