# ---------------------------------------------------------------------------
# Capability bindings — what backs each capability
# ---------------------------------------------------------------------------
AI_REASONING_PROVIDER=anthropic
AI_REASONING_MODEL=claude-sonnet-5

AI_FAST_PROVIDER=groq
AI_FAST_MODEL=llama-3.3-70b-versatile

AI_CHEAP_PROVIDER=openrouter
AI_CHEAP_MODEL=deepseek/deepseek-chat

AI_VISION_PROVIDER=google
AI_VISION_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Provider credentials — how to reach each provider
#   KIND: anthropic | google | openai-compatible
#   BASE_URL required only when KIND=openai-compatible
# ---------------------------------------------------------------------------
AI_PROVIDER_ANTHROPIC_KIND=anthropic
AI_PROVIDER_ANTHROPIC_API_KEY=

AI_PROVIDER_GOOGLE_KIND=google
AI_PROVIDER_GOOGLE_API_KEY=

AI_PROVIDER_GROQ_KIND=openai-compatible
AI_PROVIDER_GROQ_API_KEY=
AI_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1

AI_PROVIDER_OPENROUTER_KIND=openai-compatible
AI_PROVIDER_OPENROUTER_API_KEY=
AI_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Websocket hub
#
# These MUST match @miobots/protocol's ProtocolDefaults, because the canonical
# Fake Heart dials them by default. B0.4 runs `bun run sim` from the protocol
# repo with no arguments, so a PORT or DEV_TOKEN that disagrees here means the
# Heart dials 8080 with one token while the Brain listens elsewhere with
# another, and the I1 demo never connects.
#
# HOST is loopback on purpose: /dev/speak carries no token, and the rule is
# that the token is the security boundary. Set 0.0.0.0 only deliberately.
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
DEV_TOKEN=mio-dev-secret-token

# ---------------------------------------------------------------------------
# Timeouts, idempotency and message size (B0.5)
#
# Left blank deliberately: each falls back to ProtocolDefaults, so the wire
# limits have exactly one home. Set one only to override it locally. In
# particular MAX_MESSAGE_SIZE above ProtocolDefaults.MAX_PAYLOAD_BYTES (64 KB)
# does nothing useful — the codec rejects the message either way.
# ---------------------------------------------------------------------------
# MAX_MESSAGE_SIZE=
# IDEMPOTENCY_TTL_MS=
ACK_TIMEOUT=5000
IDEMPOTENCY_CLEANUP_INTERVAL_MS=60000
COMMAND_EXPIRY_MS=30000
